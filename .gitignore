# Intermedios del ensamblado. Se publica solo la ROM lista para instalar.
build/*
!build/EXPLOR2.ROM
rasmoutput.sym

# rasm es obra de Roudoudou y tiene su propia licencia: no se
# redistribuye. Ver tools/rasm.md para obtenerlo.
tools/rasm

# Datos de la tarjeta de desarrollo: personales, no del proyecto.
m4/
# Última IP de la M4 encontrada por tools/buscam4.sh
.m4ip

# Cache de Python de las herramientas.
__pycache__/
